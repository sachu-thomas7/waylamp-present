{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability set for StreamDeck. Grants minimum required permissions per window.",
  "windows": ["controller"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "shell:allow-open",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "dialog:allow-open"
  ]
}
