{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamDeck",
  "version": "0.1.0",
  "identifier": "app.streamdeck.desktop",
  "build": {
    "frontendDist": "../controller/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "node scripts/dev-both.cjs", "cwd": ".." },
    "beforeBuildCommand": { "script": "npm run build --prefix controller && npm run build --prefix presentation && node scripts/merge-presentation-dist.cjs", "cwd": ".." }
  },
  "app": {
    "windows": [
      {
        "label": "controller",
        "title": "StreamDeck — Controller",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: sdmedia: http://sdmedia.localhost; media-src 'self' sdmedia: http://sdmedia.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
